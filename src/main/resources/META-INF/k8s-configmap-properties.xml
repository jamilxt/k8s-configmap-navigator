<idea-plugin>
    <extensions defaultExtensionNs="com.jamilxt.k8s-configmap-navigator">
        <usageScanner implementation="com.jamilxt.k8sconfigmap.index.PropertiesUsageScanner"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <codeInsight.lineMarkerProvider
                language="Properties"
                implementationClass="com.jamilxt.k8sconfigmap.navigation.SpringPropertiesToConfigMapLineMarkerProvider"/>
    </extensions>
</idea-plugin>
